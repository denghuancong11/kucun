{
  "manifest_version": 3,
  "name": "Aster 领星同步",
  "version": "2.1.8",
  "minimum_chrome_version": "120",
  "description": "仅部署电脑执行领星同步，其他电脑通过库存服务提交请求。",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://erp.lingxing.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "领星后台同步设置"
  }
}
