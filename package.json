{
  "name": "aster-inventory-validation-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "migrate": "node scripts/migrate-inventory-v3.mjs",
    "initialize": "node scripts/migrate-to-sqlite.mjs",
    "verify-db": "node scripts/migrate-to-sqlite.mjs --verify",
    "typecheck": "npm --prefix web run typecheck",
    "lint": "npm --prefix web run lint",
    "test": "node scripts/verify-requirements.mjs && node scripts/verify-inquiry-final-quantity.mjs && node scripts/verify-approval-pending.mjs && node scripts/verify-transit-import-permissions.mjs && node scripts/verify-allocation-pack.mjs && node scripts/verify-allocation-review-pack.mjs && node scripts/verify-inquiry-procurement.mjs",
    "test:teams": "node scripts/verify-team-scope.mjs",
    "test:multi-page": "node web/scripts/multi-page-sync-check.mjs",
    "test:all-business-sync": "node web/scripts/all-business-sync-check.mjs",
    "test:batch-allocation": "node web/scripts/batch-allocation-history-check.mjs",
    "test:teams-page": "node web/scripts/team-scope-page-check.mjs",
    "test:page": "node web/scripts/approvals-page-check.mjs && node web/scripts/lingxing-button-check.mjs && node web/scripts/approval-clear-page-check.mjs && node web/scripts/flow-recovery-page-check.mjs",
    "test:collectors": "node scripts/verify-lingxing-page-collector.mjs && node scripts/verify-removal-page-collector.mjs",
    "test:edge-sync": "node scripts/verify-edge-sync.mjs",
    "test:edge-lifecycle": "node scripts/verify-edge-lifecycle.mjs",
    "test:report-cleanup": "node scripts/verify-report-cleanup.mjs",
    "test:worker-start": "node scripts/verify-worker-start.mjs",
    "test:host-sync": "node scripts/verify-lingxing-host.mjs",
    "test:migration": "node scripts/verify-existing-data.mjs",
    "build": "node scripts/build-edge-extension.mjs && npm --prefix web run build",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:source-scope && npm run build && npm run test:page",
    "test:recovery-page": "node web/scripts/flow-recovery-page-check.mjs",
    "test:warehouse-fba": "node scripts/verify-warehouse-fba.mjs",
    "test:warehouse-fba-page": "node web/scripts/warehouse-fba-page-check.mjs",
    "test:approval-clear": "node web/scripts/approval-clear-page-check.mjs",
    "test:source-scope": "node scripts/verify-source-scope.mjs",
    "test:upgrade-real-warehouses": "node web/scripts/real-warehouse-upgrade-page-check.mjs",
    "test:allocation-pack-page": "node web/scripts/allocation-pack-page-check.mjs",
    "test:allocation-review-pack-page": "node web/scripts/allocation-review-pack-page-check.mjs",
    "test:inquiry-procurement-page": "node web/scripts/inquiry-procurement-page-check.mjs"
  }
}
